{
  "version": 1,
  "app": "Aurora",
  "branch": "main",
  "environment": {
    "file": ".env",
    "runtime": {
      "CONTROL_ESCOLAR_MYSQL_CONNECTION_LIMIT": "30"
    },
    "aliases": {
      "NUXT_PUBLIC_GOOGLE_CLIENT_ID": "GOOGLE_CLIENT_ID",
      "NUXT_DB_TRANSPORT": "DB_TRANSPORT",
      "NUXT_DB_BRIDGE_URL": "DB_BRIDGE_URL",
      "NUXT_DB_BRIDGE_TOKEN": "DB_BRIDGE_TOKEN"
    },
    "vercel": {
      "project": "sistema-de-ingresos-2",
      "refreshOnDeploy": false
    }
  },
  "mysql": {
    "recommendedMode": "default",
    "accounts": [
      {
        "id": "central",
        "host": "%",
        "maxMode": "default",
        "schemas": [
          { "id": "central", "name": "casitaiedis" }
        ],
        "bindings": [
          {
            "schema": "central",
            "env": {
              "host": "CONTROL_ESCOLAR_MYSQL_HOST",
              "port": "CONTROL_ESCOLAR_MYSQL_PORT",
              "user": "CONTROL_ESCOLAR_MYSQL_USER",
              "password": "CONTROL_ESCOLAR_MYSQL_PASSWORD",
              "database": "CONTROL_ESCOLAR_MYSQL_DATABASE"
            }
          }
        ]
      }
    ]
  },
  "podman": {
    "preset": "nuxt",
    "nodeVersion": 22,
    "containerPort": 3000,
    "hostPort": "auto",
    "networks": ["database_database_net"],
    "labels": {
      "com.casita.service": "aurora"
    }
  },
  "health": { "path": "/", "timeoutSeconds": 120 },
  "observability": { "enabled": true },
  "domains": [
    {
      "hostname": "aurora.casitaiedis.edu.mx",
      "zone": "casitaiedis.edu.mx",
      "type": "A",
      "proxied": true
    }
  ]
}
